# Django
SECRET_KEY='replace-with-a-generated-secret-key'
# Off for the always-on service; docker-compose.dev.yml turns it back on for
# the dev container without editing this file.
DEBUG=False
# Comma-separated hosts Django may serve (no spaces around commas). Append
# your machine's Tailscale name/IP to use the app from your other devices —
# see "Access From Your Phone (Tailscale)" in the README.
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when you reach the app on a name/port other than the bare host, and
# when it sits behind an HTTPS proxy such as `tailscale serve`:
#CSRF_TRUSTED_ORIGINS=http://<machine>.<tailnet>.ts.net:8000
# True only behind a proxy that terminates HTTPS and sets X-Forwarded-Proto:
# Django then trusts that header and marks its cookies secure.
#BEHIND_TLS_PROXY=False

# Networking
# Host address the app is published on. Set this to your Tailscale address to
# expose it to the tailnet only; 127.0.0.1 keeps it on this machine.
BIND_ADDRESS=127.0.0.1
DJANGO_PORT=8000
# Rootless Docker only: run the container as root so files it writes to the
# bind mount stay owned by you.
#CONTAINER_USER=0:0

# Database
DATABASE_BACKEND=postgres
POSTGRES_DATABASE=mymoney
POSTGRES_USER=mymoney_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backups (scripts/backup.sh) — see "Automatic Backups" in the README.
# Folder the nightly database dump is written to; share it in Syncthing to
# copy the dumps to your other devices.
#BACKUP_DIR=~/mymoney-backups
# Dumps older than this many days are deleted.
#BACKUP_KEEP_DAYS=30
