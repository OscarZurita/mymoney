# Django
SECRET_KEY='replace-with-a-generated-secret-key'
DEBUG=True
# Comma-separated hosts Django may serve (no spaces around commas). Append
# your machine's Tailscale name/IP to use the app from your other devices —
# see "Access From Your Phone (Tailscale)" in the README.
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed behind an HTTPS proxy such as `tailscale serve`:
#CSRF_TRUSTED_ORIGINS=https://<machine>.<tailnet>.ts.net

# Database
DATABASE_BACKEND=postgres
POSTGRES_DATABASE=mymoney
POSTGRES_USER=mymoney_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
